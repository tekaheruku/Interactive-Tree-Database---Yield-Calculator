<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <connectionStrings>
    <!--
      Database used by the application. The program creates the database and its
      tables automatically on first run (see TreeYield.Core\Data\DatabaseInitializer.cs).

      Default: SQL Server Express LocalDB, which is installed with Visual Studio 2015.
      To use a full SQL Server Express instance instead, change Data Source, e.g.
        Data Source=.\SQLEXPRESS;Initial Catalog=TreeYieldDb;Integrated Security=True
      After building, this file is copied next to the program as TreeYield.WinForms.exe.config.
    -->
    <add name="TreeYieldDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=TreeYieldDb;Integrated Security=True;Connect Timeout=60"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
