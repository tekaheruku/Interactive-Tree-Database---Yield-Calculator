<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <connectionStrings>
    <!-- Throw-away database used only by the integration tests. It is dropped and
         re-created on every run, so it must never point to the real TreeYieldDb. -->
    <add name="TreeYieldDbTest"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=TreeYieldDb_Test;Integrated Security=True;Connect Timeout=60"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
